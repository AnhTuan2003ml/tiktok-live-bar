NODE_ENV=production
HOST=127.0.0.1
PORT=3100
LIVE_PROVIDER=auto
TIKFINITY_WS_URL=ws://127.0.0.1:21213/

# Keep disabled unless you intentionally expose the bridge to a trusted LAN.
ALLOW_LAN=0

# ── Bản quyền ────────────────────────────────
# Sinh SECRET_KEY MỚI cho mỗi sản phẩm, không dùng lại của dự án khác:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
OTP_VALID_MINUTES=5

# SMTP gửi mã kích hoạt tới hộp thư người bán
SENDMAIL_USER=
SENDMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Hai hộp thư quản trị nhận mã
RECEIVER_EMAIL_1=
RECEIVER_EMAIL_2=
