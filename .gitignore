# ═══════════════════════════════════════════════
#  .gitignore — TISO Live
#  Node.js + Unity + Media
# ═══════════════════════════════════════════════

# ── Node.js ──────────────────────────────────
node_modules/
npm-debug.log*
.env
.env.local
.env.*.local

# ── Unity (Library, cache, build) ────────────
UnityProject/Library/
UnityProject/Temp/
UnityProject/Logs/
UnityProject/UserSettings/
UnityProject/MemoryCaptures/
UnityProject/obj/
UnityProject/Build/
UnityProject/Builds/
UnityProject/CommercialBuild/
UnityProject/Assets/AssetStoreTools/

# ── Compiled Build output ────────────────────
Build/

# ── Build logs ───────────────────────────────
build_log.txt

# ── Media lớn (người dùng tự thêm) ──────────
DJ_MUSIC/*.mp3
DJ_MUSIC/*.MP3
DJ_MUSIC/*.wav
DJ_MUSIC/*.WAV
DJ_MUSIC/*.ogg
DJ_MUSIC/*.OGG
DJ_MUSIC/*.flac

DJ_VIDEO/*.mp4
DJ_VIDEO/*.MP4
DJ_VIDEO/*.mov
DJ_VIDEO/*.MOV
DJ_VIDEO/*.m4v
DJ_VIDEO/*.webm
DJ_VIDEO/*.mp4.bak

# DJ_SFX: giữ chuông chào mặc định welcome.wav, bỏ qua file người dùng tự thay.
DJ_SFX/*.mp3
DJ_SFX/*.ogg
DJ_SFX/*.tmp

# DJ_LOGO: logo do người dùng tải lên, không đưa vào repo.
DJ_LOGO/*.mp4
DJ_LOGO/*.mov
DJ_LOGO/*.m4v
DJ_LOGO/*.webm
DJ_LOGO/*.png
DJ_LOGO/*.jpg
DJ_LOGO/*.jpeg
DJ_LOGO/*.tmp

# ── OS & IDE ─────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.csproj.user
*.unityproj
*.sln
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ── Visual Studio / Rider / VSCode ───────────
.vs/
.vscode/
.idea/
*.userprefs

# ── Crash reports ────────────────────────────
sysinfo.txt
crashlytics-build.properties

# ── Goi phat hanh do package.bat tao ─────────
dist/
*.zip

# ── Cau hinh rieng cua tung may (co mat khau OBS) ──
TikTokBridge/config/operator.json
TikTokBridge/config/observed-gifts.json

# ── Unity cache o thu muc goc ────────────────
Library/
Logs/
UserSettings/

# ── Secret nhung cho ban dong goi ────────────
TikTokBridge/src/license/embedded-env.js
TikTokBridge/config/.license.dat
TikTokBridge/config/.activation.dat

# ── Khoa ky license Ed25519 — TUYET DOI khong commit ──
secrets/
*.pem

# ── Python build artifacts (trinh cai dat) ──
__pycache__/
*.pyc
*.spec
